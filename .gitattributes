# Force LF line endings for all files that end up inside Linux containers.
# Prevents "\\r: not found" errors when Windows users clone and build.

# Shell scripts (entrypoints, deploy)
*.sh text eol=lf

# Docker and container configs
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Nginx configs
*.conf text eol=lf

# PHP configs
*.ini text eol=lf
*.php text eol=lf

# SQL init scripts
*.sql text eol=lf
